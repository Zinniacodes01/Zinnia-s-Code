        "import pandas as pd\n",
        "df=pd.read_csv('car_ad.csv')\n",
        "df['year']=pd.to_numeric(df['year'], errors='coerce')\n",
        "df['mileage']=pd.to_numeric(df['mileage'], errors='coerce')\n",
        "def getcar(row):\n",
        "    if 2000<=row['year']<=2010:\n",
        "        return row['mileage']\n",
        "    else:\n",
        "        return 0\n",
        "a=df.apply(getcar, axis=1)\n",
        "print(\"Car: \",a['car'])\n",
        "print(\"Mileage: \",a['mileage'])"
      ]
